# Ambiente da aplicação
ENVIRONMENT=development

# Banco de dados (Supabase), preencher quando usar
DATABASE_URL=

# API key do Google Gemini, preencher quando usar
GEMINI_API_KEY=

# Diagnostico v2 no Claude (desligado por padrao: sem chave ou com liberacao em 0, tudo vai ao Gemini)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_ROLLOUT_PERCENT=0
CLAUDE_DAILY_LIMIT=100
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT_S=40
CLAUDE_MAX_TOKENS=8000
