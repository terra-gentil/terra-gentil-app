{
  "expo": {
    "name": "Terra Gentil",
    "slug": "terra-gentil-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "br.com.terragentil.app",
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "br.com.terragentil.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/f5d75a08-a9e1-421a-ab64-c77097cb19a0",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "f5d75a08-a9e1-421a-ab64-c77097cb19a0"
      }
    },
    "owner": "terra-gentil-app",
    "scheme": "terragentil",
    "plugins": [
      "expo-updates",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2D6A4F",
          "sounds": []
        }
      ]
    ]
  }
}
